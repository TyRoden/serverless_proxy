	# ------------------
	# Serve OpenAPI spec (STATIC)
	# ------------------
	@openapi_get {
		method GET HEAD
		path /n8n/openapi.json
	}
	handle @openapi_get {
		root * /etc/caddy/n8n
		uri strip_prefix /n8n
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET,OPTIONS"
		header Access-Control-Allow-Headers "Authorization,Content-Type,X-Webhook-Token"
		file_server
	}

	@openapi_options {
		method OPTIONS
		path /n8n/openapi.json
	}
	handle @openapi_options {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET,OPTIONS"
		header Access-Control-Allow-Headers "Authorization,Content-Type,X-Webhook-Token"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	# ------------------
	# CORS preflight for /n8n/*
	# ------------------
	@n8n_preflight {
		method OPTIONS
		path /n8n/*
	}
	handle @n8n_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET,POST,OPTIONS"
		header Access-Control-Allow-Headers "Authorization,Content-Type,X-Webhook-Token"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

