# Caddyfile Example - Serverless Proxy Routes
# 
# This is an example configuration showing how to route requests to the Serverless Proxy.
# Adjust hostnames, paths, and port numbers to match your setup.
#
# The Serverless Proxy exposes:
#   - FastAPI on port 8002 (API endpoints)
#   - Flask admin UI on port 5001 (admin dashboard)
#
# Key routes for the proxy:
#   - /v1/* - OpenAI-compatible API endpoints
#   - /v1/messages - Anthropic API compatible endpoint
#   - /api/admin/* - Admin API endpoints
#   - /proxy-dashboard - Admin UI
#   - /endpoints - Flask endpoints API
#   - /virtual-models - Flask virtual models API

# ------------------
# Serverless Proxy Routes
# ------------------

# Reverse proxy API requests to the proxy (port 8002)
@proxy-api path /v1/* /api/* /v1/models /v1/chat/completions /v1/completions /v1/embeddings
handle @proxy-api {
    reverse_proxy localhost:8002
}

# Reverse proxy admin API to Flask admin (port 5001)
# Must be BEFORE the generic /api/* handler above
@proxy-admin path /api/admin/* /endpoints* /virtual-models*
handle @proxy-admin {
    reverse_proxy localhost:5001
}

# Serve admin dashboard static files
handle /proxy-dashboard {
    reverse_proxy localhost:5001
}

# ------------------
# Note: Add more routes above this line for your other services
# ------------------

# Catch-all for other services (OpenWebUI, etc.)
# @everything_else path *
# handle @everything_else {
#     reverse_proxy localhost:8080
# }
